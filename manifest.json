{
  "manifest_version": 3,
  "name": "Adyen Link Auto-Pay",
  "version": "1.3.0",
  "description": "Auto-fill, auto-submit and capture checkoutshopper payment requests as cURL.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webRequest",
    "notifications"
  ],
  "host_permissions": [
    "https://checkoutshopper-live.adyen.com/*",
    "https://checkoutshopper-test.adyen.com/*",
    "https://*.adyen.com/*",
    "https://*.adyen.link/*",
    "https://adyen.link/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Adyen Link Auto-Pay",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://checkoutshopper-live.adyen.com/*",
        "https://checkoutshopper-test.adyen.com/*",
        "https://*.adyen.com/*",
        "https://*.adyen.link/*",
        "https://adyen.link/*"
      ],
      "js": ["lib/cardgen.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}