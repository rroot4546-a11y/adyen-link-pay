{
  "manifest_version": 3,
  "name": "Adyen Link Auto-Pay",
  "version": "1.8.1",
  "description": "Auto-fill, auto-submit, proxy + UA rotation, sandbox-gated Telegram hit bridge, capture as cURL + verdicts.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webRequest",
    "notifications",
    "debugger",
    "proxy"
  ],
  "host_permissions": [
    "https://checkoutshopper-live.adyen.com/*",
    "https://checkoutshopper-test.adyen.com/*",
    "https://*.adyen.com/*",
    "https://*.adyen.link/*",
    "https://adyen.link/*",
    "https://api.telegram.org/*",
    "<all_urls>"
  ],
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Adyen Link Auto-Pay",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://checkoutshopper-live.adyen.com/*",
        "https://checkoutshopper-test.adyen.com/*",
        "https://*.adyen.com/*",
        "https://*.adyen.link/*",
        "https://adyen.link/*"
      ],
      "js": [
        "lib/cardgen.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
