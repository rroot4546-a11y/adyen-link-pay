{
  "manifest_version": 3,
  "name": "Adyen Link Auto-Pay",
  "version": "1.12.2",
  "description": "Auto-fill, auto-submit, inbuilt modal auto-pay + checkoutshopper paste-to-pay — panel on any page with embedded Adyen + Stripe (hosted payment links / inbuilt Elements); Lab mode affirmation unlocks any host/page, proxy + UA rotation, Telegram hit bridge.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webRequest",
    "notifications",
    "debugger",
    "proxy"
  ],
  "host_permissions": [
    "https://checkoutshopper-live.adyen.com/*",
    "https://checkoutshopper-test.adyen.com/*",
    "https://*.adyen.com/*",
    "https://*.adyen.link/*",
    "https://adyen.link/*",
    "https://*.stripe.com/*",
    "https://*.stripe.network/*",
    "https://api.stripe.com/*",
    "https://api.telegram.org/*",
    "<all_urls>"
  ],
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Adyen Link Auto-Pay",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://checkoutshopper-live.adyen.com/*",
        "https://checkoutshopper-test.adyen.com/*",
        "https://*.adyen.com/*",
        "https://*.adyen.link/*",
        "https://adyen.link/*",
        "https://*.stripe.com/*",
        "https://*.stripe.network/*",
        "http://127.0.0.1/*",
        "http://localhost/*",
        "<all_urls>"
      ],
      "js": [
        "lib/cardgen.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
